# Скопируйте этот файл в .env и заполните своими ключами

# OpenAI API ключ (обязательно)
OPENAI_API_KEY=sk-your-key-here

# Модель для ответов (по умолчанию gpt-4o-mini — дёшево и быстро)
LLM_MODEL=gpt-4o-mini

# Модель для эмбеддингов (локальная, не требует API ключа)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Путь к базе знаний
KNOWLEDGE_BASE_DIR=./knowledge_base

# Путь к сохранённому индексу
INDEX_DIR=./index

# Количество чанков для поиска
TOP_K=5
